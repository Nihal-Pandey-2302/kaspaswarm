        "span": "entrypoint function draw() {\n        byte[34] agentScriptPubKey = new ScriptPubKeyP2PK(agent);\n        require(tx.outputs[0].scriptPubKey == byte[](agentScriptPubKey));\n\n        int start = int(windowStart);\n        require(tx.time >= start);\n\n        int elapsed = tx.locktime - start;\n        int allowance = elapsed * allowancePerBlock;\n\n        int minerFee = 1000;\n        int currentValue = tx.inputs[this.activeInputIndex].value;\n        int changeValue = currentValue - allowance - minerFee;\n\n        if (changeValue <= allowancePerBlock + minerFee) {\n            // Draining the last tranche: send the remainder to the agent.\n            require(tx.outputs[0].value == currentValue - minerFee);\n        } else {\n            // Draw exactly the accrued allowance; re-lock the rest to this covenant\n            // with windowStart advanced to the current block (state transition).\n            require(tx.outputs[0].value == allowance);\n            require(tx.outputs[1].value == changeValue);\n\n            byte[] newState = 8 + byte[8](tx.locktime) + this.activeScriptPubKey.split(9).1;\n            byte[35] relock = new ScriptPubKeyP2SH(blake2b(newState));\n            require(tx.outputs[1].scriptPubKey == byte[](relock));\n        }\n    }",
        "name_span": "draw",
        "body_span": "byte[34] agentScriptPubKey = new ScriptPubKeyP2PK(agent);\n        require(tx.outputs[0].scriptPubKey == byte[](agentScriptPubKey));\n\n        int start = int(windowStart);\n        require(tx.time >= start);\n\n        int elapsed = tx.locktime - start;\n        int allowance = elapsed * allowancePerBlock;\n\n        int minerFee = 1000;\n        int currentValue = tx.inputs[this.activeInputIndex].value;\n        int changeValue = currentValue - allowance - minerFee;\n\n        if (changeValue <= allowancePerBlock + minerFee) {\n            // Draining the last tranche: send the remainder to the agent.\n            require(tx.outputs[0].value == currentValue - minerFee);\n        } else {\n            // Draw exactly the accrued allowance; re-lock the rest to this covenant\n            // with windowStart advanced to the current block (state transition).\n            require(tx.outputs[0].value == allowance);\n            require(tx.outputs[1].value == changeValue);\n\n            byte[] newState = 8 + byte[8](tx.locktime) + this.activeScriptPubKey.split(9).1;\n            byte[35] relock = new ScriptPubKeyP2SH(blake2b(newState));\n            require(tx.outputs[1].scriptPubKey == byte[](relock));\n        }"
