# Kaspa Network Configuration
KASPA_RPC_URL=https://api.kaspa.org
KASPA_NETWORK=testnet-10

# Coordination transport (live mode):
#   sdk  = official Kaspa Python SDK via Resolver (auto-selects a community node;
#          no node IP needed) — the default and recommended path.
#   handrolled = legacy wRPC/REST stack against KASPA_WS_URL (a local node).
KASPA_TRANSPORT=sdk

# Swarm Configuration
NUM_COORDINATORS=2
NUM_SOLVERS=8

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Development Mode (set to true for mock mode without real blockchain)
MOCK_MODE=false

# Coordinator wallet credentials (LIVE mode only; never commit real values).
# Generate a fresh testnet keypair, fund the address, and put values in .env (gitignored).
COORDINATOR_ADDRESS=
COORDINATOR_PRIVATE_KEY=

# Derives stable, fundable agent addresses (so they persist across restarts and
# can be funded once via fund_agents.py). Any stable secret string.
AGENT_MASTER_SEED=

# AI agents (optional). Any OpenAI-compatible endpoint — Groq (free/fast), AICredits,
# OpenAI, or local Ollama (http://localhost:11434/v1). If LLM_API_KEY is empty, agents
# fall back to deterministic tasks so the swarm still runs.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
